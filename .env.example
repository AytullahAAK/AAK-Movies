# Server-only credentials. Do not prefix these with VITE_; the TMDB proxy reads them server-side.
TMDB_READ_ACCESS_TOKEN=
# Public v3 key is accepted only by the local Vite development proxy.
# It is read by vite.config.ts and is not referenced from browser code.
VITE_TMDB_API_KEY=

# Optional real production origin for canonical/OG URLs; leave empty for local previews.
VITE_SITE_URL=

# Optional real account sign-in. These are public Supabase project values, not service-role secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep addon lookups off until rights, provider permission, authentication, and rate limits are verified.
# Keep configured manifest URLs server-side; provider URLs may contain credentials.
ENABLE_AUTHORIZED_ADDON_LOOKUPS=false
TORRENTIO_MANIFEST_URL=
HDHUB_MANIFEST_URL=
# Optional, exact hostnames only; these are the only addon URLs allowed in an iframe.
AUTHORIZED_EMBED_HOSTS=

# Reserved for a future rights-reviewed remote media service integration.
# These are server-only settings and are not read by the current application.
REMOTE_STREAM_SERVICE_URL=
REMOTE_STREAM_SERVICE_TOKEN=
