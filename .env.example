# Optional local demo credentials. Both VITE_ values are compiled into the browser bundle.
# Prefer VITE_TMDB_READ_ACCESS_TOKEN locally; never commit real credentials.
VITE_TMDB_READ_ACCESS_TOKEN=
# Public TMDB v3 key fallback; honored only during local Vite development.
VITE_TMDB_API_KEY=

# Optional real production origin for canonical/OG URLs; leave empty for local previews.
VITE_SITE_URL=
